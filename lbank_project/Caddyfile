# Public entry point of the customer site (portal-public-compose.yml). TLS is automatic for {$PORTAL_DOMAIN}.
{$PORTAL_DOMAIN} {
	encode zstd gzip
	# Blog image upload accepts up to 10MB (portal_blog.MAX_UPLOAD); every other request body stays at 1MB.
	@blog_upload path /api/admin/blog/images
	@other_bodies not path /api/admin/blog/images
	request_body @other_bodies {
		max_size 1MB
	}
	request_body @blog_upload {
		max_size 10MB
	}
	# Security headers (HSTS, CSP, Permissions-Policy, ...) are set only by the application, so there is one source of truth.
	header {
		-Server
	}
	reverse_proxy portal:8080 {
		header_down -Server
	}
}
www.{$PORTAL_DOMAIN} {
	redir https://{$PORTAL_DOMAIN}{uri} permanent
}
