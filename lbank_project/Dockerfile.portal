FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt requirements-portal.txt ./
RUN pip install --no-cache-dir -r requirements-portal.txt
COPY portal_server.py portal_store.py portal_database.py portal_jobs.py portal_worker.py portal_exchanges.py portal_migrate.py portal_runtime.py portal_lbank.py portal_admin.py portal_billing.py capital_plans.py customer_manager.py license_access.py portal.html portal.js portal_license.js portal.css ./
COPY portal_assets ./portal_assets
CMD ["python", "-u", "portal_server.py"]
