FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt requirements-portal.txt ./
RUN pip install --no-cache-dir -r requirements-portal.txt
COPY portal_issuer.py portal_billing.py portal_store.py portal_database.py portal_audit.py portal_telegram.py portal_referrals.py capital_plans.py product_pricing.py license_access.py ./
CMD ["python", "-u", "portal_issuer.py", "--private-key", "/run/secrets/license_private"]
